# Helping Hands Foundation: environment variables
# Copy to .env.local for local development. In production, set these in your host (e.g. Vercel → Settings → Environment Variables).
# Never commit real keys.

# Public address of the site (used for payment callbacks, sitemap and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Payments (Paystack, USD) ----------
# Leave PAYSTACK_SECRET_KEY empty and card payments stay switched off (nothing is charged).
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
# Live keys (sk_live_...) are refused unless this is "true". Keep false until the foundation approves going live.
PAYMENTS_ALLOW_LIVE=false
# Monthly giving: set to "true" only after confirming USD subscription plans work on the Paystack account.
PAYSTACK_RECURRING_ENABLED=false

# ---------- Form delivery (Contact & Get Involved) ----------
# Option A: Resend (recommended). All three are required.
RESEND_API_KEY=
FORMS_TO_EMAIL=
FORMS_FROM_EMAIL=
# Option B: Formspree form endpoint, e.g. https://formspree.io/f/abcd1234
FORMSPREE_ENDPOINT=
